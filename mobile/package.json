{
  "name": "reporta-cotia-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node scripts/expo.cjs development start",
    "start:lan": "node scripts/expo.cjs development start --go --lan --port 8082",
    "start:dev-client": "node scripts/expo.cjs development start --dev-client --lan --port 8082",
    "start:staging": "node scripts/expo.cjs staging start --clear",
    "start:production": "node scripts/expo.cjs production start --clear",
    "android": "node scripts/expo.cjs development run:android",
    "ios": "node scripts/expo.cjs development run:ios",
    "expo:env": "node scripts/expo.cjs",
    "config": "node scripts/expo.cjs development config --type public",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:config": "node --test tests/environment.test.cjs tests/maps-config.test.cjs",
    "check": "npm run typecheck && npm run test:config && npm test",
    "export": "node scripts/expo.cjs development export --platform all",
    "smoke:api": "node scripts/smoke-api.cjs"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "axios": "^1.13.0",
    "dotenv": "^17.2.3",
    "expo": "~57.0.30",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-file-system": "~57.0.7",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-location": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "axios-mock-adapter": "^2.1.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  }
}
